+void memory_partition_unit::request_pop(unsigned local_id) {
+  assert(local_id < sub_partition_count());
+  m_sub_partition[local_id]->L2_dram_queue_pop();
+}
+bool memory_partition_unit::response_full(unsigned local_id) const {
+  assert(local_id < sub_partition_count());
+  return m_sub_partition[local_id]->dram_L2_queue_full();
+}
+void memory_partition_unit::response_push(unsigned local_id, mem_fetch *request) {
+  assert(local_id < sub_partition_count());
+  assert(m_sub_partition[local_id]->get_id() == request->get_sub_partition_id());
+  m_sub_partition[local_id]->dram_L2_queue_push(request);
+}
+void memory_partition_unit::writeback_done(unsigned local_id, mem_fetch *request) {
+  assert(local_id < sub_partition_count());
+  assert(m_sub_partition[local_id]->get_id() == request->get_sub_partition_id());
+  m_sub_partition[local_id]->set_done(request);
